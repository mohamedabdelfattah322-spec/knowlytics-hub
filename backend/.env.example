PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=change_this_to_a_random_secret
FRONTEND_URL=https://your-frontend.up.railway.app
BACKEND_URL=https://your-backend.up.railway.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ─── Paymob (Egypt) ───────────────────────────────────────
# Required for any Paymob method
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# Per-method integration IDs (each is a separate "integration" in your Paymob dashboard).
# Leave empty to disable that method. At least one of these is required.
PAYMOB_INTEGRATION_ID=                # Card (Visa / MasterCard / Meeza)
PAYMOB_WALLET_INTEGRATION_ID=         # Mobile wallet (Vodafone Cash, Orange, InstaPay)
PAYMOB_KIOSK_INTEGRATION_ID=          # Cash via Fawry / Aman
PAYMOB_VALU_INTEGRATION_ID=           # ValU instalments

# ─── Stripe (International) ───────────────────────────────
# Set these to enable card payments from outside Egypt (USD)
STRIPE_SECRET_KEY=                    # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=                # whsec_... (from Stripe webhook settings)
EGP_TO_USD=0.021                      # EGP→USD conversion rate (override as needed)
